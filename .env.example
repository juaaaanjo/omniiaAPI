# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/business-analytics

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OpenAI API (ChatGPT)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Meta Ads API (Facebook/Instagram)
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token
META_ADS_API_VERSION=v18.0
META_ADS_APP_ID=your_meta_app_id
META_ADS_APP_SECRET=your_meta_app_secret

# Shopify API
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SHOP_NAME=your-shop-name
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# Transaction API (Google Cloud Function)
TRANSACTION_API_URL=https://getadmin-transactions-1092365299699.us-east1.run.app

# Redis (for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000
